#include <tunables/global>



profile oj-judge flags=(attach_disconnected) {

  #include <abstractions/base>

  #include <abstractions/nameservice>



  # Deny all capabilities

  deny capability,



  # Allow basic file operations in /sandbox

  /sandbox/** rwix,

  /sandbox/ r,



  # Allow read access to system libraries

  /usr/lib/** r,

  /usr/lib/x86_64-linux-gnu/** r,

  /lib/** r,

  /lib/x86_64-linux-gnu/** r,



  # Allow compiler and runtime binaries

  /bin/** rix,

  /usr/bin/** rix,

  /usr/lib/gcc/** rix,

  /usr/include/** r,

  /usr/lib/jvm/** rix,



  # Allow read access to locale and timezone data

  /usr/share/locale/** r,

  /usr/share/zoneinfo/** r,



  # Allow basic process info

  /proc/self/maps r,

  /proc/self/stat r,

  /proc/self/status r,



  # Deny access to other processes

  deny /proc/[0-9]*/** rw,



  # Deny sensitive system files

  deny /etc/passwd rw,

  deny /etc/shadow rw,

  deny /etc/group rw,

  deny /etc/gshadow rw,

  deny /etc/hosts rw,

  deny /etc/hostname rw,

  deny /etc/resolv.conf rw,



  # Deny network

  deny network,



  # Deny devices

  deny /dev/** rw,



  # Deny sysctl

  deny /proc/sys/** rw,



  # Deny home/root

  deny /home/** rw,

  deny /root/** rw,



  # The container mounts /tmp as tmpfs. Compilers and runtimes need it for
  # temporary files, but it remains isolated from the host and non-executable
  # under this AppArmor policy.
  /tmp/** rw,



  # Deny ptrace and signal (简化)

  deny ptrace,

  deny signal,



  # Deny mount/umount

  deny mount,

  deny umount,



  # Deny module access

  deny /sys/module/** rw,



  # Allow standard library data

  /usr/share/** r,

}
