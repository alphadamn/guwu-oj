#include <tunables/global>



profile oj-judge flags=(attach_disconnected) {

  #include <abstractions/base>

  #include <abstractions/nameservice>



  # Deny all capabilities

  deny capability,



  # Allow basic file operations in /sandbox

  /sandbox/** rwmkix,

  /sandbox/ r,


  # Shared ccache directory, bind-mounted from the judge host and reused by
  # every judge container on that host. Read/write/lock only: no execute, so
  # the cache can never become an alternate launch path for a submission.
  /ccache/ rw,
  /ccache/** rwmk,

  # Precompiled C++ standard library header baked into the oj-cpp image;
  # g++ only ever reads it (mmap), never writes.
  /pch/ r,
  /pch/** rm,

  # ojrun: static per-case timing wrapper bind-mounted read-only from the
  # judge host (replaces /usr/bin/time with µs-resolution wall clock +
  # wait4 rusage). Execute-only launch path; the mount itself is ro.
  /opt/oj/ r,
  /opt/oj/** rix,


  # A login shell runs the timed test command and sources /etc/profile, whose
  # Debian default loops over /etc/profile.d/*.sh. Denying that turned every
  # test case into audit-log denials.
  /etc/profile.d/ rix,
  /etc/profile.d/** r,



  # Allow read access to system libraries

  # Native runtimes dynamically map shared libraries at startup.
  /usr/lib/** rm,

  /usr/lib/x86_64-linux-gnu/** rm,

  /lib/** rm,

  /lib/x86_64-linux-gnu/** rm,



  # Allow compiler and runtime binaries

  /bin/** rix,

  /usr/bin/** rix,

  /usr/lib/gcc/** rix,

   /usr/lib/go-1.19/** rix,

  /usr/include/** r,

  # Java loads JNI libraries such as libnio.so on demand, requiring map access.
  /usr/lib/jvm/** rmix,

  # The Debian OpenJDK configuration is symlinked from the JDK into /etc.
  # Java must read java.security before either javac or java can start.
  /etc/java-17-openjdk/** r,



  # Allow read access to locale and timezone data

  /usr/share/locale/** r,

  /usr/share/zoneinfo/** r,



  # Allow basic process info

  /proc/self/maps r,

  /proc/self/stat r,

  /proc/self/status r,

  # 允许 Java 读取系统硬件/CPU/内存信息（用于性能调优）
  /sys/devices/system/cpu/possible r,
  /sys/fs/cgroup/cpu.max r,
  /sys/fs/cgroup/memory.max r,
  /sys/kernel/mm/hugepages/ r,
  /sys/kernel/mm/transparent_hugepage/enabled r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  # 允许 Java 写入 coredump_filter（用于异常处理）
  /proc/*/coredump_filter rw,

  # Docker's PID namespace hides host processes; allow procfs reads needed by
  # managed runtimes and by the container-pool sanitiser, which enumerates
  # tasks with a /proc/[0-9]* glob (readdir needs the directory itself).
  /proc/ r,
  /proc/** r,



  # Deny sensitive system files

  deny /etc/passwd rw,

  deny /etc/shadow rw,

  deny /etc/group rw,

  deny /etc/gshadow rw,

  deny /etc/hosts rw,

  deny /etc/hostname rw,

  deny /etc/resolv.conf rw,



  # No namespace network interfaces are present (`--network none`); deny socket
  # creation while allowing Java's Unix-domain socketpair used during startup.
  deny network inet,
  deny network inet6,



  # Docker exposes only the allowlisted device nodes passed by sandbox.py.
  # The JVM opens /dev/null read/write during NIO initialization.
  /dev/** rwm,



  # Deny sysctl

  deny /proc/sys/** rw,



  # Deny home/root

  deny /home/** rw,

  deny /root/** rw,



  # The container mounts /tmp as tmpfs. Compilers and runtimes need it for
  # temporary files, but it remains isolated from the host and non-executable
  # under this AppArmor policy.
  /tmp/** rwmk,



  # Signalling policy.
  #
  # runc / dockerd are unconfined and must be able to terminate judge tasks
  # (host-side timeouts, ``docker kill`` on pool recycle).
  signal (receive) peer=unconfined,
  #
  # Processes inside ONE container may signal each other. Without this the
  # profile denied kill() between its own tasks, silently disabling the
  # compile-step ``timeout 1``, ojrun/TLE termination, interactive
  # ``timeout -k``, and the pool sanitiser's stray-process kill. Signalling
  # ANOTHER container stays impossible regardless of this rule: every
  # container owns a separate PID namespace, so foreign PIDs are unaddressable.
  signal peer=oj-judge,



  # Deny mount/umount

  deny mount,

  deny umount,



  # Deny module access

  deny /sys/module/** rw,



  # Allow standard library data

  /usr/share/** r,

  /usr/lib/ssl/openssl.cnf r,
  /etc/ssl/openssl.cnf r,
  /etc/profile r,

}
