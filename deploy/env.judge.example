# Copy to /root/guwu-oj/.env on the judge host, then replace every value.
# This file contains no deployable credentials and must remain safe to commit.
DJANGO_SECRET_KEY=<shared-django-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<web-or-database-host>
DB_PORT=5432

# Must point to the web host cache so the worker clears web-visible cache keys.
CACHE_REDIS_HOST=<web-cache-redis-host>
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=1
CACHE_REDIS_PASSWORD=<cache-redis-password>

# The worker's local Redis that owns the judge queue.
RQ_REDIS_HOST=127.0.0.1
RQ_REDIS_PORT=6379
RQ_REDIS_DB=0
RQ_REDIS_PASSWORD=<rq-redis-password>

JUDGE_1_HOST=127.0.0.1
JUDGE_1_PORT=6379
JUDGE_1_REDIS_DB=0
OJ_MULTI_JUDGE_ENABLED=true
OJ_DOCKER_ENABLED=true
OJ_DOCKER_PIDS_LIMIT=64
# Submissions one worker process judges in parallel (threads).
OJ_JUDGE_CONCURRENCY=4
# Warm per-language container pool: pre-created containers remove the
# per-submission docker-run overhead. Defaults are sensible; leave unset to
# use them. Set OJ_CONTAINER_POOL_ENABLED=false to restore the old
# one-container-per-submission behaviour.
#OJ_CONTAINER_POOL_ENABLED=true
#OJ_CONTAINER_POOL_MIN_IDLE=1
#OJ_CONTAINER_POOL_MEMORY_MB=1024
#OJ_CONTAINER_POOL_MAX_USES=50
#OJ_CONTAINER_POOL_MAX_AGE_SEC=3600
OJ_ROLE=worker
