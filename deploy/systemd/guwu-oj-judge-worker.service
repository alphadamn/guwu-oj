[Unit]
Description=Guwu OJ RQ Judge Worker (central broker)
After=network.target docker.service redis-server.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/guwu-oj
EnvironmentFile=/root/guwu-oj/.env
Environment=OJ_ROLE=worker
# Central-broker judge worker (Phase 1).
# Every judge machine runs the same unit: it competes for jobs on the central
# broker lanes (JUDGE_BROKER_URL in .env). Adding a machine = install this
# unit + point JUDGE_BROKER_URL at the central Redis; no Django-side config.
ExecStart=/root/guwu-oj/venv/bin/python manage.py rqworker judge:queue-pro judge:queue-plus judge:queue judge:queue-ai --worker-class oj_project.customrq.AutoReconnectWorker
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
